@model List<Category>

<div class="container">
    <div class="row pt-3 pd-3">
        <div class="col-6">
            <h2>Список категорий</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Category" asp-action="Create" class="btn btn-primary">Create Category</a>
        </div>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <td>Id</td>
                <td>Name</td>
                <td>DisplayOrder</td>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.OrderDisplay</td>
                </tr>
            }
        </tbody>
    </table>
</div>